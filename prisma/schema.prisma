// GearUp — Production Prisma Schema (Prisma ORM 7)
//
// Prisma 7 requires an explicit driver adapter (no bundled engine binary),
// and generates a plain TS/JS client into a project folder instead of
// node_modules. The DB connection URL now lives in prisma.config.ts,
// not in this file — see that file for the datasource wiring.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RentalStatus {
  PLACED
  CONFIRMED
  PAID
  PICKED_UP
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Not one of the four mandatory enums, but modeling it as an enum
// (rather than a free-text string) prevents typos like "stripe" vs
// "Stripe" from ever reaching the database.
enum PaymentMethod {
  STRIPE
  SSLCOMMERZ
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Line-item kinds for an order's itemized breakdown. Explicit enum so a
// typo can never create an unrecognized line type.
enum OrderLineItemType {
  RENTAL
  SERVICE_FEE
  DEPOSIT
  TAX
  DAMAGE_FEE
  LATE_FEE
  REFUND
  ADJUSTMENT
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role
  status    UserStatus @default(ACTIVE)
  phone     String?
  emailVerifiedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // A user can be a provider (owns gear) and/or a customer (places orders)
  // depending on `role`, but both relations live on the same model since
  // role is decided at registration, not enforced structurally.
  gearItems    Gear[]        @relation("ProviderGear")
  rentalOrders RentalOrder[] @relation("CustomerRentals")
  reviews      Review[]

  sessions           Session[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]

  // Frequent filters in the admin panel: "all suspended users",
  // "all providers", etc.
  @@index([role])
  @@index([status])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gearItems Gear[]

  @@map("categories")
}

model Gear {
  id            String   @id @default(uuid())
  title         String
  description   String
  brand         String?
  pricePerDay   Decimal  @db.Decimal(10, 2)
  stock         Int      @default(1)
  isAvailable   Boolean  @default(true)
  images        String[]
  averageRating Float    @default(0)
  reviewCount   Int      @default(0)
  // Denormalized on purpose: Prisma can't ORDER BY an aggregate across a
  // relation efficiently at scale. These two columns are recalculated by
  // the Reviews module every time a review is created/updated/deleted,
  // so "sort by rating" is a plain indexed column read, not a per-request
  // aggregation over every review row.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Restrict (not Cascade): deleting a category that still has gear under
  // it should fail loudly, forcing an admin to reassign or remove the
  // gear first, rather than silently orphaning or nuking listings.

  providerId String
  provider   User   @relation("ProviderGear", fields: [providerId], references: [id], onDelete: Cascade)
  // Cascade: if a provider account is deleted outright, their listings
  // don't make sense to keep around. In practice most platforms prefer
  // suspending providers instead of hard-deleting them, but this is the
  // safe default if a hard delete does happen.

  rentalOrders RentalOrder[]
  reviews      Review[]
  availabilityBlocks GearAvailabilityBlock[]

  // Supports the "browse/filter gear" endpoints: by category, by
  // provider's own inventory view, by availability, and price-range
  // filtering/sorting.
  @@index([categoryId])
  @@index([providerId])
  @@index([isAvailable])
  @@index([pricePerDay])
  @@index([averageRating])
  @@index([brand])
  @@map("gear_items")
}

model RentalOrder {
  id          String       @id @default(uuid())
  quantity    Int          @default(1)
  startDate   DateTime
  endDate     DateTime
  totalDays   Int
  // Computed once at creation from (endDate - startDate), rounded up to a
  // whole day. Persisted rather than derived on every read so order
  // history stays stable and cheap to query/sort.
  pricePerDay Decimal      @db.Decimal(10, 2)
  // Snapshotted from Gear.pricePerDay at order creation time, so a later
  // price change by the provider never rewrites historical order totals.
  // Breakdown columns below are all snapshots computed once at creation by
  // the pricing util, then frozen — a later env/config change (fee %,
  // deposit %) must never rewrite a historical order's numbers.
  subtotal    Decimal      @db.Decimal(10, 2) @default(0)
  // subtotal = pricePerDay * quantity * totalDays (the rental cost only).
  serviceFee    Decimal @db.Decimal(10, 2) @default(0)
  // Platform commission, subtotal * PLATFORM_FEE_PERCENT.
  depositAmount Decimal @db.Decimal(10, 2) @default(0)
  // Refundable security deposit, subtotal * DEPOSIT_PERCENT (0 = none).
  taxAmount     Decimal @db.Decimal(10, 2) @default(0)
  // Tax added by the tax provider (populated in the tax sub-phase).
  currency    String       @default("USD")
  // ISO-4217 code snapshot, so a later CURRENCY change never rewrites
  // historical orders. Kept on the order as well as the payment.
  totalAmount Decimal      @db.Decimal(10, 2)
  // Grand total charged = subtotal + serviceFee + depositAmount + taxAmount.
  status      RentalStatus @default(PLACED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  customerId String
  customer   User   @relation("CustomerRentals", fields: [customerId], references: [id], onDelete: Restrict)
  // Restrict: rental history is financial/audit data. A customer account
  // should be suspended, never hard-deleted, while orders reference it.

  gearId String
  gear   Gear   @relation(fields: [gearId], references: [id], onDelete: Restrict)
  // Restrict: same reasoning — historical orders must keep pointing at a
  // real gear record for auditing, even if that gear is later marked
  // unavailable.

  payment Payment?
  review  Review?
  lineItems OrderLineItem[]
  // Itemized audit/display trail mirroring the breakdown columns above.
  // The columns are the source of truth for totals; line items exist so the
  // customer (and support) can see how the total was composed, and so later
  // phases can append fees (damage/late/tax) without overwriting history.

  @@index([customerId])
  @@index([gearId])
  @@index([status])
  @@index([startDate, endDate])
  // Drives the overlap query used to enforce date-scoped availability:
  // "quantity of reserving orders for this gear whose [start,end) intersects
  // the requested window".
  @@index([gearId, status, startDate, endDate])
  @@map("rental_orders")
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  // ISO-4217 code snapshot for this charge, independent of the order's
  // current value (a payment is an immutable record of what was charged).
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  rawResponse   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  rentalOrderId String      @unique
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  // Cascade: a Payment record has no independent meaning without its
  // order — if the order is ever purged, its payment record should go
  // with it (in practice orders are never hard-deleted, only cancelled).

  @@index([status])
  @@map("payments")
}

model OrderLineItem {
  id          String            @id @default(uuid())
  rentalOrderId String
  rentalOrder RentalOrder       @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  // Cascade: line items are a component of the order and meaningless
  // without it (orders are cancelled, never hard-deleted, in practice).
  type        OrderLineItemType
  amount      Decimal           @db.Decimal(10, 2)
  // Signed amount in the order currency: fees/deposits are positive,
  // refunds/adjustments may be negative, so the sum reconstructs the total.
  currency    String            @default("USD")
  description String?
  createdAt   DateTime          @default(now())

  @@index([rentalOrderId])
  @@map("order_line_items")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  gearId String
  gear   Gear   @relation(fields: [gearId], references: [id], onDelete: Cascade)
  // Cascade on both: a review is meaningless without the customer or the
  // gear it's attached to, unlike Payment/RentalOrder which are financial
  // records worth preserving.

  rentalOrderId String?      @unique
  rentalOrder   RentalOrder? @relation(fields: [rentalOrderId], references: [id], onDelete: SetNull)
  // Links the review back to the specific order it came from, so the
  // service layer can enforce "only after RETURNED". SetNull rather than
  // Cascade/Restrict: if the order is ever removed, the review can stand
  // on its own as historical feedback rather than being deleted too.

  // One review per customer per gear item — prevents review spam even
  // across multiple separate orders of the same item.
  @@unique([customerId, gearId])
  @@index([gearId])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────
// Availability
// ─────────────────────────────────────────────────────────────

model GearAvailabilityBlock {
  id        String   @id @default(uuid())
  gearId    String
  gear      Gear     @relation(fields: [gearId], references: [id], onDelete: Cascade)
  // Half-open window [startDate, endDate): the gear is fully unavailable
  // (all units) to customers for any rental that intersects this range.
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gearId, startDate, endDate])
  @@map("gear_availability_blocks")
}

// ─────────────────────────────────────────────────────────────
// Auth lifecycle, audit
// ─────────────────────────────────────────────────────────────

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Only a SHA-256 hash of the refresh token is stored — a leaked DB row
  // cannot be replayed as a live credential.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
