# GearUp Backend — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000

# --- CORS ---
# Comma-separated list of allowed origins. Use * to allow any origin (credentials are disabled when * is used).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/gearup

# --- Auth ---
# Must be at least 10 characters. Use a long, random value in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- SSLCommerz (optional secondary payment method; not implemented yet) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
