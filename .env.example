# GearUp Backend — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000

# --- CORS ---
# Comma-separated list of allowed origins. Use * to allow any origin (credentials are disabled when * is used).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/gearup

# --- Auth ---
# JWT_SECRET must be at least 10 characters. Use a long, random value in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Access-token lifetime (short) and refresh-token lifetime (days).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
# When true, customers/providers must verify their email before renting or paying.
REQUIRE_EMAIL_VERIFICATION=false
BCRYPT_SALT_ROUNDS=12

# --- Email (SMTP) ---
# Leave SMTP_HOST empty for local dev — messages are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GearUp <no-reply@gearup.local>

# --- Pricing & currency ---
# ISO-4217 code used for order/payment snapshots (USD default).
CURRENCY=USD
# Whole-number percentages applied to the rental subtotal.
# PLATFORM_FEE_PERCENT is the platform service fee (10 == 10%).
# DEPOSIT_PERCENT is the refundable security deposit held at booking.
PLATFORM_FEE_PERCENT=10
DEPOSIT_PERCENT=0

# --- Cancellation policy ---
# Full charge refund when cancelling at least this many hours before the start
# date; inside the window a partial refund applies; none once the rental starts.
CANCELLATION_FULL_REFUND_HOURS=48
# Whole-number percent of the charge refunded inside the partial window.
CANCELLATION_PARTIAL_REFUND_PERCENT=50

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- SSLCommerz (optional secondary payment method; not implemented yet) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# --- Rate limiting ---
# Optional. When set, rate-limit counters are shared via Redis; otherwise in-memory.
REDIS_URL=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Error tracking (optional) ---
# Leave empty to disable Sentry.
SENTRY_DSN=
