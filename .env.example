# GearUp Backend — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
# Public URL of the web client — used to build links inside outgoing emails.
FRONTEND_URL=http://localhost:3000

# --- CORS ---
# Comma-separated list of allowed origins. Use * to allow any origin (credentials are disabled when * is used).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/gearup

# --- Auth ---
# JWT_SECRET must be at least 10 characters. Use a long, random value in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Access-token lifetime (short) and refresh-token lifetime (days).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
# When true, customers/providers must verify their email before renting or paying.
REQUIRE_EMAIL_VERIFICATION=false
BCRYPT_SALT_ROUNDS=12

# --- Email ---
# Preferred: HTTP email API over HTTPS (443). Helps on hosts/ISPs that block
# outbound SMTP ports. When set, this takes precedence over SMTP below.
# Get a key at https://resend.com/api-keys. MAIL_FROM must use a domain
# verified in Resend — or `onboarding@resend.dev`, which can only send to the
# Resend account owner's own email address.
RESEND_API_KEY=

# Fallback: SMTP (used only when RESEND_API_KEY is empty). When SMTP_HOST is
# also unset, messages are captured in the logs instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GearUp <no-reply@gearup.local>

# --- Pricing & currency ---
# ISO-4217 code used for order/payment snapshots (USD default).
CURRENCY=USD
# Whole-number percentages applied to the rental subtotal.
# PLATFORM_FEE_PERCENT is the platform service fee (10 == 10%).
# DEPOSIT_PERCENT is the refundable security deposit held at booking.
PLATFORM_FEE_PERCENT=10
DEPOSIT_PERCENT=0

# --- Cancellation policy ---
# Full charge refund when cancelling at least this many hours before the start
# date; inside the window a partial refund applies; none once the rental starts.
CANCELLATION_FULL_REFUND_HOURS=48
# Whole-number percent of the charge refunded inside the partial window.
CANCELLATION_PARTIAL_REFUND_PERCENT=50

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- SSLCommerz (optional secondary payment method; not implemented yet) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# --- Rate limiting & OTP store ---
# Optional. When set, Redis backs both the shared rate-limit counters and the
# registration OTP store; otherwise an in-memory fallback is used (dev/tests).
# You can either set a full URL here, or leave it empty and fill the parts
# below — the URL is then assembled at boot.
REDIS_URL=
# Individual connection parts (used only when REDIS_URL is empty).
REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Registration OTP ---
# Lifetime of a verification code and the abuse limits around it.
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Error tracking (optional) ---
# Leave empty to disable Sentry.
SENTRY_DSN=
